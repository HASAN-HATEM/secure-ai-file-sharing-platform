DATABASE_URL=postgres://postgres:postgres@db:5432/securefiles
JWT_SECRET=replace-with-random-jwt-secret
NEXTAUTH_SECRET=replace-with-random-nextauth-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000
WEB_PORT=3000
SCANNER_SERVICE_URL=http://ai:8000
AI_SERVICE_URL=http://ai:8000
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=your-r2-bucket-name
S3_ACCESS_KEY_ID=your-r2-access-key-id
S3_SECRET_ACCESS_KEY=your-r2-secret-access-key
MAX_UPLOAD_BYTES=26214400
ALLOWED_MIME=application/pdf,text/plain,image/png,image/jpeg,application/octet-stream
RESCAN_ON_DOWNLOAD=false
FILE_MASTER_KEY_BASE64=base64-encoded-32-byte-key
FILE_MASTER_KEY_ID=master-key-v1
