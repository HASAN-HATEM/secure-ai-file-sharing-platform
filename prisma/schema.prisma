generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum FileObjectStatus {
  PENDING
  READY
  QUARANTINED
  FAILED

  @@map("file_object_status")
}

model audit_logs {
  id            Int       @id @default(autoincrement())
  actor_user_id Int?
  action        String
  target_type   String
  target_id     Int?
  timestamp     DateTime? @default(now()) @db.Timestamptz(6)
  details       Json?
  users         users?    @relation(fields: [actor_user_id], references: [id], onUpdate: NoAction)
}

model classification_results {
  id              Int       @id @default(autoincrement())
  file_id         Int?
  classifier_type String
  label           String?
  confidence      Float?    @db.Real
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  files           files?    @relation(fields: [file_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model file_permissions {
  id                   Int       @id @default(autoincrement())
  file_id              Int?
  user_id              Int?
  can_download         Boolean?  @default(true)
  wrapped_key_for_user String?
  wrap_iv_for_user     String?
  created_at           DateTime? @default(now()) @db.Timestamptz(6)
  files                files?    @relation(fields: [file_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([file_id, user_id])
}

model files {
  id                     Int                      @id @default(autoincrement())
  owner_id               Int?
  filename               String
  mime_type              String
  size_bytes             BigInt
  encrypted_blob         Bytes
  iv                     String
  wrap_iv                String
  wrapped_key            String
  created_at             DateTime?                @default(now()) @db.Timestamptz(6)
  classification_results classification_results[]
  file_permissions       file_permissions[]
  users                  users?                   @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  scan_results           scan_results[]
}

model scan_results {
  id            Int       @id @default(autoincrement())
  file_id       Int?
  is_malicious  Boolean
  score         Float?    @db.Real
  model_version String?
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  files         files?    @relation(fields: [file_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model users {
  id                    Int                     @id @default(autoincrement())
  name                  String
  email                 String                  @unique
  password_hash         String
  role                  String                  @default("USER")
  package_key           String                  @default("free")
  key_salt              Bytes
  avatar_url                      String?
  email_verified                  Boolean   @default(true)
  email_verification_token        String?
  email_verification_expires_at   DateTime? @db.Timestamptz(6)
  utm_email                       String?
  utm_verification_token          String?
  utm_verification_pending_email  String?
  utm_verification_expires_at     DateTime? @db.Timestamptz(6)
  disabled              Boolean                 @default(false)
  created_at            DateTime?               @default(now()) @db.Timestamptz(6)
  audit_logs            audit_logs[]
  file_permissions      file_permissions[]
  files                 files[]
  fileObjectPermissions FileObjectPermission[]
  password_reset_tokens password_reset_tokens[]
  friendsAsOwner        Friend[]                @relation("FriendOwner")
  friendsAsFriend       Friend[]                @relation("FriendOf")
}

model Friend {
  id           String   @id @default(cuid())
  ownerId      Int      @map("owner_id")
  friendUserId Int      @map("friend_user_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  owner        users    @relation("FriendOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  friend       users    @relation("FriendOf", fields: [friendUserId], references: [id], onDelete: Cascade)

  @@map("friends")
  @@unique([ownerId, friendUserId], map: "friends_unique")
  @@index([ownerId], map: "friends_owner_idx")
}

model SystemSettings {
  id              Int      @id @default(1)
  maintenanceMode Boolean  @default(false) @map("maintenance_mode")
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("system_settings")
}

model password_reset_tokens {
  id         Int       @id @default(autoincrement())
  user_id    Int
  token_hash String    @unique
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  ip_address String?
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model FileObject {
  id                 String           @id @default(cuid())
  ownerId            String           @map("owner_id")
  filename           String
  mimeType           String           @map("mime_type")
  sizeBytes          BigInt           @map("size_bytes")
  tempKey            String?          @map("temp_key")
  storageKey         String?          @unique @map("storage_key")
  status             FileObjectStatus @default(PENDING)
  scanScore          Float?           @map("scan_score")
  scanIsMalicious    Boolean?         @map("scan_is_malicious")
  scanModelVersion   String?          @map("scan_model_version")
  categoryLabel      String?          @map("category_label")
  categoryConfidence Float?           @map("category_confidence")
  encAlgo            String?          @map("enc_algo")
  encIvBase64        String?          @map("enc_iv_base64")
  encTagBase64       String?          @map("enc_tag_base64")
  encKeyId           String?          @map("enc_key_id")
  encDekBase64       String?          @map("enc_dek_base64")
  deletedAt          DateTime?        @map("deleted_at") @db.Timestamptz(6)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  scanResults        ScanResult[]
  classifications    ClassificationResult[]
  permissions        FileObjectPermission[]

  @@map("file_objects")
  @@index([ownerId, status], map: "file_objects_owner_status_idx")
}

model ScanResult {
  id           String    @id @default(cuid())
  fileObjectId String    @map("file_object_id")
  isMalicious  Boolean   @map("is_malicious")
  score        Float?
  modelVersion String?   @map("model_version")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  fileObject   FileObject @relation(fields: [fileObjectId], references: [id], onDelete: Cascade)

  @@map("scan_results_v2")
  @@index([fileObjectId], map: "scan_results_v2_file_object_idx")
}

model ClassificationResult {
  id            String    @id @default(cuid())
  fileObjectId  String    @map("file_object_id")
  classifier    String    @map("classifier")
  label         String
  confidence    Float?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  fileObject    FileObject @relation(fields: [fileObjectId], references: [id], onDelete: Cascade)

  @@map("classification_results_v2")
  @@index([fileObjectId], map: "classification_results_v2_file_object_idx")
}

model FileObjectPermission {
  id           String    @id @default(cuid())
  fileObjectId String    @map("file_object_id")
  recipientUserId Int    @map("recipient_user_id")
  secretHash   String?   @map("secret_hash")
  canDownload  Boolean   @default(true) @map("can_download")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  fileObject   FileObject @relation(fields: [fileObjectId], references: [id], onDelete: Cascade)
  recipient    users      @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@map("file_object_permissions")
  @@unique([fileObjectId, recipientUserId], map: "file_object_permissions_unique")
  @@index([recipientUserId], map: "file_object_permissions_user_idx")
}
